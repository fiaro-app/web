# Origen de la API de Fiaro; la web reenvía /api/* hacia aquí (ver next.config.ts).
API_URL=http://localhost:3000

# Origen público de la web: enlaces canónicos, sitemap e imágenes sociales.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Llave pública del widget Cloudflare Turnstile. Sin ella no se muestra el widget (útil en pruebas
# locales); en producción debe corresponder a la llave secreta de la API.
# NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Origen del almacenamiento de archivos (logos), p. ej. https://pub-xxxx.r2.dev. Se agrega a la CSP
# (img-src y connect-src) para mostrar y subir el logo. Sin él, la pantalla de Configuración no sube logos.
STORAGE_ORIGIN=
